# Supabase project URL (find in: Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase anon/public key (find in: Dashboard → Settings → API)
# This key is safe to be public — security is handled by Row Level Security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Leave blank for local dev (uses localhost:5173 root path)
# Only needed if you manually build for a sub-path deployment.
# VITE_BASE_PATH=/
