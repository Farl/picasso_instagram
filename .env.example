# Supabase project URL (find in: Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Publishable key (Dashboard → Connect button → Frameworks → React)
# Or: Settings → API Keys → Publishable key
# New format: sb_publishable_xxx  (older projects may still use eyJ... anon key — both work)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# GitHub Personal Access Token for GitHub Models inference
# Used at build time so deployed demo works without user entering a token.
# Get one at: https://github.com/settings/tokens (no special scope needed)
# In GitHub Actions this is available automatically as secrets.GITHUB_TOKEN
VITE_GITHUB_TOKEN=github_pat_...

# Leave blank for local dev (uses localhost:5173 root path)
# Only needed if you manually build for a sub-path deployment.
# VITE_BASE_PATH=/
