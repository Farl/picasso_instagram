# Supabase project URL (find in: Dashboard → Settings → API)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase Publishable key (Dashboard → Connect button → Frameworks → React)
# Or: Settings → API Keys → Publishable key
# New format: sb_publishable_xxx  (older projects may still use eyJ... anon key — both work)
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Leave blank for local dev (uses localhost:5173 root path)
# Only needed if you manually build for a sub-path deployment.
# VITE_BASE_PATH=/
